# ============================================================
#  Git 行为规范：统一换行符，避免 Windows/macOS/Linux 协作时
#  出现整文件“全量变更”的换行符噪音（LF 入库，检出时按平台处理）
# ============================================================
* text=auto

# 源码与文档统一以 LF 提交
*.cpp text eol=lf
*.h   text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.json text eol=lf

# 二进制文件不做任何转换
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
*.png binary
*.jpg binary
